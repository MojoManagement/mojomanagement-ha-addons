# Options for running the bridge outside Home Assistant (`npm start`).
# Every add-on option can be set as an environment variable in upper case.
# Copy to yt-cast-audio-bridge/app/.env. All values are optional.

BRIDGE_NAME_PREFIX=Audio ->
BRIDGE_SCREEN_PREFIX=YouTube on
ONLY_AUDIO_LIKE=1
INCLUDE_GROUPS=1
AUTOPLAY=1
INCLUDE_REGEX=
EXCLUDE_REGEX=
# Comma-separated names, IP addresses or Cast ids; when set, only these are offered
PINNED_HOSTS=
MAX_RECEIVERS=25
OFFLINE_HIDE_AFTER_MS=180000
DIAL_BASE_PORT=3000
# Comma-separated IPv4 addresses / interface names; empty = detect automatically
DIAL_BIND_TO_ADDRESSES=
DIAL_BIND_TO_INTERFACES=
YT_DLP_AUTO_UPDATE=1
YT_COOKIES_FILE=
LOG_LEVEL=INFO

# Only outside Home Assistant:
HEALTH_PORT=3099
# Folder for state and the self-updated yt-dlp (default: ./state)
DATA_DIR=
# Use this yt-dlp binary and never update it
YT_DLP_BIN=
# 1 = serve the status page to any client, not just localhost
UI_OPEN=0
