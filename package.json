{
  "name": "mojomanagement-ha-addons",
  "private": true,
  "description": "Convenience scripts for the add-ons in this repository",
  "scripts": {
    "postinstall": "npm --prefix yt-cast-audio-bridge/app ci --no-audit --no-fund",
    "build": "npm --prefix yt-cast-audio-bridge/app run build",
    "start": "npm --prefix yt-cast-audio-bridge/app start",
    "typecheck": "npm --prefix yt-cast-audio-bridge/app run typecheck",
    "lint": "npm --prefix yt-cast-audio-bridge/app run lint",
    "test": "npm --prefix yt-cast-audio-bridge/app test",
    "check": "npm --prefix yt-cast-audio-bridge/app run check"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
